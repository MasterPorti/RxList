# Configuración para Vercel. No subas este archivo con valores reales.
SESSION_SECRET=genera-un-secreto-largo-y-aleatorio
API_GEMINI=tu-api-key-de-gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
NEXT_PUBLIC_DEFAULT_PROVIDER=gemini

# Demo para compañeros. Cambia a false cuando tengas usuarios reales.
DEMO_MODE=true
ALLOW_DEMO_LOGIN=true
PUBLIC_DEMO=true
NEXT_PUBLIC_DEMO_MODE=true
RESET_DEMO_ON_START=false

# Whisper local no se despliega en Vercel. Déjalo vacío o usa un servicio externo compatible.
